---
interface Props { version: string }
const { version } = Astro.props;

const releaseBase = 'https://github.com/talayash/agentrium/releases/latest/download';

const artifacts = {
  macos: [
    { label: 'Apple Silicon', file: `Agentrium_${version}_aarch64.dmg` },
    { label: 'Intel',         file: `Agentrium_${version}_x64.dmg` },
  ],
  windows: [
    { label: 'NSIS (recommended)', file: `Agentrium_${version}_x64-setup.exe` },
    { label: 'MSI',                file: `Agentrium_${version}_x64_en-US.msi` },
  ],
} as const;
---

<section id="download" class="section download night-band">
  <div class="night-glow"></div>
  <div class="container-wide download-inner">
    <p class="kicker download-kicker reveal">Download</p>
    <h2 class="h2 download-h2 on-night reveal" style="--d: 60ms">Free. Open source.<br />Direct from GitHub.</h2>

    <div class="prereq glass-night reveal" style="--d: 120ms">
      <p class="prereq-line on-night-2">
        Requires Node.js 22+ and at least one agent CLI installed globally.
        Claude Code is the quickest start; Codex, Cursor, and Antigravity are
        auto-detected once on your PATH.
      </p>
      <div class="prereq-cmd">
        <code>npm i -g @anthropic-ai/claude-code</code>
        <button
          class="prereq-copy"
          data-copy="npm i -g @anthropic-ai/claude-code"
          aria-label="Copy install command"
        >Copy</button>
      </div>
    </div>

    <div class="os-blocks">
      <div class="os-block glass-night reveal" style="--d: 180ms">
        <h3 class="h3 os-name on-night">macOS</h3>
        <p class="os-req on-night-3">macOS 11 or later</p>
        <div class="artifacts">
          {artifacts.macos.map(a => (
            <a class="artifact" href={`${releaseBase}/${a.file}`}>
              <span class="artifact-file">{a.file}</span>
              <span class="artifact-tag">{a.label}</span>
            </a>
          ))}
        </div>
      </div>

      <div class="os-block glass-night reveal" style="--d: 260ms">
        <h3 class="h3 os-name on-night">Windows</h3>
        <p class="os-req on-night-3">Windows 10 or later</p>
        <div class="artifacts">
          {artifacts.windows.map(a => (
            <a class="artifact" href={`${releaseBase}/${a.file}`}>
              <span class="artifact-file">{a.file}</span>
              <span class="artifact-tag">{a.label}</span>
            </a>
          ))}
        </div>
      </div>
    </div>

    <p class="download-note on-night-3 reveal">
      Builds are not code-signed yet. On macOS, right-click the app then choose Open
      (or run <code>xattr -dr com.apple.quarantine /Applications/Agentrium.app</code>).
      On Windows, SmartScreen shows a warning: click More info, then Run anyway.
      The source is on GitHub.
    </p>
  </div>
</section>

<style>
  .download { text-align: left; }
  .download-inner { position: relative; z-index: 1; max-width: 880px; }

  .download-kicker { color: #6FB4FF; }
  .download-h2 { margin: 14px 0 40px; }

  .prereq {
    border-radius: var(--radius-card);
    padding: 22px 24px;
    margin-bottom: 26px;
  }
  .prereq-line { font-size: 14px; line-height: 1.6; margin: 0 0 14px; }
  .prereq-cmd {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    background: rgba(0, 0, 0, 0.35);
    border: 1px solid var(--night-seam);
    border-radius: 10px;
    padding: 10px 14px;
  }
  .prereq-cmd code {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--night-text);
  }
  .prereq-copy {
    font-family: inherit;
    font-size: 12px;
    font-weight: 600;
    color: var(--night-text-2);
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid var(--night-seam-strong);
    border-radius: 999px;
    padding: 5px 14px;
    cursor: pointer;
    transition: color 150ms ease-out, background 150ms ease-out;
  }
  .prereq-copy:hover { color: #fff; background: rgba(255, 255, 255, 0.16); }
  .prereq-copy.done { color: #fff; background: var(--accent); border-color: transparent; }

  .os-blocks {
    display: grid;
    grid-template-columns: 1fr;
    gap: 22px;
  }
  @media (min-width: 640px) {
    .os-blocks { grid-template-columns: 1fr 1fr; }
  }

  .os-block {
    border-radius: var(--radius-card);
    padding: 24px;
  }
  .os-name { margin-bottom: 2px; }
  .os-req { font-size: 12px; margin: 0 0 18px; }

  .artifacts {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .artifact {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    padding: 12px 14px;
    border-radius: 10px;
    border: 1px solid var(--night-seam-strong);
    background: rgba(255, 255, 255, 0.04);
    text-decoration: none;
    transition: background 160ms ease-out, border-color 160ms ease-out, transform 160ms ease-out;
  }
  .artifact:hover {
    background: rgba(10, 132, 255, 0.14);
    border-color: rgba(10, 132, 255, 0.45);
    transform: translateY(-1px);
  }
  .artifact-file {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--night-text);
    word-break: break-all;
  }
  .artifact-tag {
    font-size: 11px;
    color: var(--night-text-3);
    white-space: nowrap;
  }

  .download-note {
    margin: 32px 0 0;
    font-size: 12px;
    line-height: 1.7;
    max-width: 70ch;
  }
  .download-note code {
    font-family: var(--font-mono);
    font-size: 11.5px;
    color: var(--night-text-2);
  }
</style>

<script>
  document.querySelectorAll('.prereq-copy').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const text = btn.getAttribute('data-copy') || '';
      try {
        await navigator.clipboard.writeText(text);
        const prev = btn.textContent;
        btn.textContent = 'Copied';
        btn.classList.add('done');
        setTimeout(() => { btn.textContent = prev; btn.classList.remove('done'); }, 1400);
      } catch { /* clipboard blocked, no-op */ }
    });
  });
</script>
