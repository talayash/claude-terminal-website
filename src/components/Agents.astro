---
// The four supported agents. Binaries and install commands mirror the
// README table in talayash/agentrium.
const agents = [
  {
    name: 'Claude Code',
    binary: 'claude',
    dot: '#D97757',
    blurb: 'The quickest start. Session restore, resume by id, and Claude-only flags are first-class.',
  },
  {
    name: 'Codex',
    binary: 'codex',
    dot: '#19C37D',
    blurb: 'OpenAI’s coding agent, auto-detected the moment it lands on your PATH.',
  },
  {
    name: 'Cursor',
    binary: 'agent',
    dot: '#9B9BF7',
    blurb: 'The Cursor CLI agent, running in its own native terminal next to the rest.',
  },
  {
    name: 'Antigravity',
    binary: 'agy',
    dot: '#4285F4',
    blurb: 'Google’s cloud-backed agent, mixed freely into tabs and grid cells.',
  },
];
---

<section id="agents" class="section agents">
  <div class="container-wide">
    <p class="kicker reveal">Agents</p>
    <h2 class="h2 agents-h2 reveal" style="--d: 60ms">
      Four agents.<br />Pick per session.
    </h2>
    <p class="subhead agents-sub reveal" style="--d: 120ms">
      Every terminal you spawn targets the agent you choose. Mix them across
      tabs and the grid; a brand mark on every session shows what is running.
    </p>

    <div class="agents-grid">
      {agents.map((a, i) => (
        <div class="agent-card glass reveal" style={`--d: ${i * 70}ms`}>
          <span class="agent-dot" style={`background:${a.dot}`} aria-hidden="true"></span>
          <h3 class="h3 agent-name">{a.name}</h3>
          <code class="agent-binary">$ {a.binary}</code>
          <p class="body-sm agent-blurb">{a.blurb}</p>
        </div>
      ))}
    </div>

    <p class="meta agents-note reveal">
      Only one agent is required to get started. The rest are auto-detected
      once installed; Settings shows exactly what is on your PATH.
    </p>
  </div>
</section>

<style>
  .agents { background: var(--page); }

  .agents-h2 { margin-bottom: 18px; }
  .agents-sub { max-width: 52ch; margin-bottom: 56px; }

  .agents-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 18px;
  }
  @media (max-width: 1023px) { .agents-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 559px) { .agents-grid { grid-template-columns: 1fr; } }

  .agent-card {
    border-radius: var(--radius-card);
    padding: 26px 22px;
    transition: transform 240ms cubic-bezier(0.22, 1, 0.36, 1), box-shadow 240ms ease-out;
  }
  .agent-card:hover {
    transform: translateY(-4px);
    box-shadow: inset 0 1px 0 var(--edge-light-bright), var(--shadow-float-md);
  }

  .agent-dot {
    display: block;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    margin-bottom: 16px;
    box-shadow: 0 0 12px 1px currentColor;
  }
  .agent-name { margin-bottom: 6px; }
  .agent-binary {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--muted-label);
    margin-bottom: 12px;
  }
  .agent-blurb { margin: 0; }

  .agents-note { margin-top: 36px; }
</style>
