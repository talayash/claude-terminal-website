---
interface Props {
  version: string;
}
const { version } = Astro.props;

const releaseBase = 'https://github.com/talayash/agentrium/releases/latest/download';
const winInstaller = `${releaseBase}/Agentrium_${version}_x64-setup.exe`;
const macInstaller = `${releaseBase}/Agentrium_${version}_aarch64.dmg`;

// The mock session sidebar: one card per agent, matching the app's new
// single-switcher IA (session cards, not tabs).
const sessions = [
  { name: 'api-refactor', agent: 'Claude Code', dot: '#D97757', status: 'Working', active: true },
  { name: 'auth-hotfix', agent: 'Codex', dot: '#19C37D', status: 'Waiting on you', active: false },
  { name: 'docs-site', agent: 'Cursor', dot: '#9B9BF7', status: 'Done', active: false },
  { name: 'perf-sweep', agent: 'Antigravity', dot: '#4285F4', status: 'Idle', active: false },
];
---

<section class="hero night-band">
  <div class="night-glow"></div>

  <div class="container-wide hero-inner">
    <p class="hero-kicker reveal">v{version} &middot; macOS + Windows &middot; free and open source</p>

    <h1 class="display hero-h1 reveal" style="--d: 80ms">
      Every agent.<br />One window.
    </h1>

    <p class="subhead hero-sub reveal" style="--d: 160ms">
      Agentrium is the native desktop home for Claude Code, Codex, Cursor,
      and Antigravity. Spawn sessions, mix agents, and watch them work side by side.
    </p>

    <div class="hero-cta reveal" style="--d: 240ms">
      <a
        id="hero-primary-dl"
        class="btn-light-pill"
        href="#download"
        data-win={winInstaller}
        data-mac={macInstaller}
      >
        Download
      </a>
      <a
        class="btn-glass-night"
        href="https://github.com/talayash/agentrium"
        target="_blank"
        rel="noopener noreferrer"
      >
        View on GitHub
      </a>
    </div>

    <!-- Live product mockup: built from the app's real design tokens -->
    <div class="app-window reveal" style="--d: 340ms" role="img" aria-label="The Agentrium main window: a frosted glass sidebar of session cards next to an active Claude Code terminal">
      <div class="win-titlebar">
        <div class="win-dots" aria-hidden="true">
          <span style="background:#FF5F57"></span>
          <span style="background:#FEBC2E"></span>
          <span style="background:#28C840"></span>
        </div>
        <div class="win-title">Agentrium</div>
        <div class="win-chip">
          <span class="win-chip-pulse" aria-hidden="true"></span>Working
        </div>
      </div>

      <div class="win-body">
        <aside class="win-sidebar">
          <div class="win-side-label">Sessions</div>
          {sessions.map((s) => (
            <div class={`win-card${s.active ? ' active' : ''}`}>
              <span class="win-agent-dot" style={`background:${s.dot}`} aria-hidden="true"></span>
              <span class="win-card-text">
                <span class="win-card-name">{s.name}</span>
                <span class="win-card-sub">{s.agent} &middot; {s.status}</span>
              </span>
              {s.active && <span class="win-card-stripe" aria-hidden="true"></span>}
            </div>
          ))}
          <div class="win-new">+ New Session</div>
        </aside>

        <div class="win-main">
          <div class="win-session-head">
            <span class="win-session-name">api-refactor</span>
            <span class="win-branch">
              <svg width="10" height="10" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M5 3.25a.75.75 0 1 1-1.5 0 .75.75 0 0 1 1.5 0Zm0 2.122a2.25 2.25 0 1 0-1.5 0v.878A2.25 2.25 0 0 0 5.75 8.5h1.5v2.128a2.251 2.251 0 1 0 1.5 0V8.5h1.5a2.25 2.25 0 0 0 2.25-2.25v-.878a2.25 2.25 0 1 0-1.5 0v.878a.75.75 0 0 1-.75.75h-4.5A.75.75 0 0 1 5 6.25v-.878Zm3.75 7.378a.75.75 0 1 1-1.5 0 .75.75 0 0 1 1.5 0Zm3-8.75a.75.75 0 1 0 0-1.5.75.75 0 0 0 0 1.5Z"/></svg>
              feat/session-store
            </span>
            <span class="win-model">Claude &middot; opus</span>
          </div>

          <div class="win-term" id="hero-term" data-played="false">
            <div class="term-line"><span class="term-prompt">&gt;</span> <span class="term-typed" id="term-typed"></span><span class="term-caret agr-caret" aria-hidden="true"></span></div>
            <div class="term-out" data-line="1"><span class="term-glyph" style="color:#D97757">&#9679;</span> Reading src/store/terminalStore.ts</div>
            <div class="term-out" data-line="2"><span class="term-glyph" style="color:#D97757">&#9679;</span> Edited terminalStore.ts <span class="term-add">+42</span> <span class="term-del">-17</span></div>
            <div class="term-out" data-line="3"><span class="term-glyph" style="color:#28C840">&#10003;</span> 388 tests passed</div>
            <div class="term-out term-dim" data-line="4">Session cost: $0.14 &middot; 2m 31s</div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="hero-fade" aria-hidden="true"></div>
</section>

<style>
  .hero {
    padding: 168px 0 0;
    text-align: center;
  }
  @media (max-width: 767px) { .hero { padding-top: 128px; } }

  .hero-inner { position: relative; z-index: 1; }

  .hero-kicker {
    font-size: 14px;
    font-weight: 500;
    color: var(--night-text-2);
    margin: 0 0 22px;
  }

  .hero-h1 {
    color: var(--night-text);
    margin: 0 auto 24px;
    background: linear-gradient(180deg, #FFFFFF 30%, #B9C4E8 100%);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .hero-sub {
    color: var(--night-text-2);
    max-width: 56ch;
    margin: 0 auto 36px;
  }

  .hero-cta {
    display: inline-flex;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
    justify-content: center;
    margin-bottom: 84px;
  }

  /* ---------- The mock app window ---------- */

  .app-window {
    max-width: 980px;
    margin: 0 auto;
    border-radius: 18px;
    overflow: hidden;
    text-align: left;
    background:
      radial-gradient(700px 420px at 62% -10%, rgba(59, 82, 180, 0.42), transparent 70%),
      radial-gradient(560px 420px at 18% 108%, rgba(122, 91, 255, 0.25), transparent 72%),
      var(--night-0);
    border: 1px solid var(--night-seam-strong);
    box-shadow: var(--shadow-float-lg);
  }

  .win-titlebar {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 11px 14px;
    background: var(--glass-night);
    -webkit-backdrop-filter: blur(20px) saturate(180%);
    backdrop-filter: blur(20px) saturate(180%);
    border-bottom: 1px solid var(--night-seam);
  }
  .win-dots { display: flex; gap: 7px; }
  .win-dots span { width: 11px; height: 11px; border-radius: 50%; display: block; }
  .win-title {
    flex: 1;
    text-align: center;
    font-size: 12.5px;
    font-weight: 600;
    color: var(--night-text-2);
    letter-spacing: -0.01em;
  }
  .win-chip {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 11px;
    font-weight: 500;
    color: var(--night-text-2);
    background: rgba(255, 255, 255, 0.07);
    border: 1px solid var(--night-seam);
    padding: 3px 10px;
    border-radius: 999px;
  }
  .win-chip-pulse {
    width: 6px; height: 6px; border-radius: 50%;
    background: var(--accent);
    animation: win-pulse 1.6s ease-in-out infinite;
  }
  @keyframes win-pulse {
    0%, 100% { opacity: 1; box-shadow: 0 0 0 0 rgba(10, 132, 255, 0.5); }
    50% { opacity: 0.6; box-shadow: 0 0 0 4px rgba(10, 132, 255, 0); }
  }

  .win-body {
    display: grid;
    grid-template-columns: 232px 1fr;
    min-height: 380px;
  }
  @media (max-width: 700px) {
    .win-body { grid-template-columns: 1fr; }
    .win-sidebar { display: none; }
  }

  .win-sidebar {
    padding: 14px 10px;
    background: var(--glass-night-thin);
    -webkit-backdrop-filter: blur(20px) saturate(160%);
    backdrop-filter: blur(20px) saturate(160%);
    border-right: 1px solid var(--night-seam);
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .win-side-label {
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--night-text-3);
    padding: 2px 8px 6px;
  }
  .win-card {
    position: relative;
    display: flex;
    align-items: center;
    gap: 9px;
    padding: 9px 10px;
    border-radius: 10px;
    transition: background 160ms ease-out;
  }
  .win-card:hover { background: rgba(255, 255, 255, 0.05); }
  .win-card.active {
    background: rgba(255, 255, 255, 0.09);
    box-shadow: inset 0 1px 0 var(--edge-light);
  }
  .win-card-stripe {
    position: absolute;
    left: 0;
    top: 8px;
    bottom: 8px;
    width: 3px;
    border-radius: 3px;
    background: var(--accent);
  }
  .win-agent-dot { width: 8px; height: 8px; border-radius: 50%; flex: none; }
  .win-card-text { display: flex; flex-direction: column; gap: 1px; min-width: 0; }
  .win-card-name {
    font-size: 12.5px;
    font-weight: 600;
    color: var(--night-text);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .win-card-sub {
    font-size: 10.5px;
    color: var(--night-text-3);
    white-space: nowrap;
  }
  .win-new {
    margin-top: auto;
    font-size: 12px;
    font-weight: 500;
    color: var(--night-text-2);
    border: 1px dashed var(--night-seam-strong);
    border-radius: 10px;
    padding: 8px 10px;
    text-align: center;
  }

  .win-main { display: flex; flex-direction: column; }

  .win-session-head {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 12px 18px;
    border-bottom: 1px solid var(--night-seam);
  }
  .win-session-name {
    font-size: 13px;
    font-weight: 600;
    color: var(--night-text);
  }
  .win-branch {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-size: 11px;
    color: var(--night-text-2);
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid var(--night-seam);
    padding: 2px 9px;
    border-radius: 999px;
    font-family: var(--font-mono);
  }
  .win-model {
    margin-left: auto;
    font-size: 11px;
    color: var(--night-text-3);
  }

  .win-term {
    flex: 1;
    padding: 18px 20px;
    font-family: var(--font-mono);
    font-size: 12.5px;
    line-height: 2.05;
    color: var(--night-text-2);
  }
  .term-prompt { color: #5B8DFF; }
  .term-typed { color: var(--night-text); }
  .term-caret {
    display: inline-block;
    width: 7px;
    border-bottom: 2px solid rgba(255, 255, 255, 0.9);
    margin-left: 2px;
  }
  .term-out {
    opacity: 0;
    transform: translateY(6px);
    transition: opacity 0.45s ease-out, transform 0.45s ease-out;
  }
  .term-out.show { opacity: 1; transform: none; }
  .term-glyph { margin-right: 6px; }
  .term-add { color: #28C840; }
  .term-del { color: #FF6B6B; }
  .term-dim { color: var(--night-text-3); font-size: 11.5px; }

  /* Soft fade from the night hero into the light page below */
  .hero-fade {
    height: 120px;
    margin-top: -1px;
    background: linear-gradient(180deg, transparent, var(--page));
    position: relative;
    z-index: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .win-chip-pulse { animation: none; }
    .term-out { opacity: 1; transform: none; }
  }
</style>

<script>
  // Platform-aware CTA: the primary button auto-targets the visitor's OS
  // installer, falling back to #download when the platform is unknown.
  const el = document.getElementById('hero-primary-dl');
  if (el) {
    const ua = navigator.userAgent;
    const plat = (navigator.platform || '') + ' ' + ua;
    const isMac = /Mac|iPhone|iPad/i.test(plat);
    const isWin = /Win/i.test(plat);
    const win = el.getAttribute('data-win');
    const mac = el.getAttribute('data-mac');
    if (isMac && mac) {
      el.setAttribute('href', mac);
      el.textContent = 'Download for macOS';
    } else if (isWin && win) {
      el.setAttribute('href', win);
      el.textContent = 'Download for Windows';
    }
  }

  // Terminal vignette: type the task, then reveal the agent's output lines.
  // Plays once, when the mockup scrolls into view.
  const term = document.getElementById('hero-term');
  const typedEl = document.getElementById('term-typed');
  const TASK = 'refactor the session store to derive unread state';
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  function playTerm() {
    if (!term || term.dataset.played === 'true') return;
    term.dataset.played = 'true';
    const outs = term.querySelectorAll('.term-out');
    if (reduced) {
      if (typedEl) typedEl.textContent = TASK;
      outs.forEach((o) => o.classList.add('show'));
      return;
    }
    let i = 0;
    const type = () => {
      if (!typedEl) return;
      i += 1;
      typedEl.textContent = TASK.slice(0, i);
      if (i < TASK.length) {
        window.setTimeout(type, 26 + Math.random() * 34);
      } else {
        outs.forEach((o, idx) => {
          window.setTimeout(() => o.classList.add('show'), 420 + idx * 520);
        });
      }
    };
    window.setTimeout(type, 500);
  }

  if (term) {
    const io = new IntersectionObserver(
      (entries) => {
        if (entries.some((e) => e.isIntersecting)) {
          playTerm();
          io.disconnect();
        }
      },
      { threshold: 0.35 }
    );
    io.observe(term);
  }
</script>
