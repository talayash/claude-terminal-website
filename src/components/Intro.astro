---
// The app's launch splash, recreated for the web: a lone blinking
// underscore, "Agentrium" typed character by character, the command
// submitted, then the app icon springs in over the gradient loading bar.
// Shown once per browser session; click / key / scroll skips. Hidden by
// default so bots and no-JS visitors never see an overlay.
---

<div id="agr-intro" aria-hidden="true">
  <div class="intro-glow"></div>

  <div class="intro-cmd" id="intro-cmd">
    <span class="intro-prompt">&gt;</span><span id="intro-typed"></span><span class="intro-underscore agr-caret">&nbsp;</span>
  </div>

  <div class="intro-logo-wrap" id="intro-logo" hidden>
    <img src="/icons/icon.png" alt="" width="120" height="120" class="intro-icon" draggable="false" />
  </div>

  <div class="intro-loader" id="intro-loader" hidden>
    <div class="intro-bar">
      <div class="intro-bar-fill" id="intro-bar-fill"></div>
      <div class="intro-bar-sheen" id="intro-bar-sheen"></div>
    </div>
    <div class="intro-wordmark">Agentrium</div>
  </div>
</div>

<style>
  #agr-intro {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: none;
    align-items: center;
    justify-content: center;
    background: #0a0a12;
    cursor: pointer;
    overflow: hidden;
    transition: opacity 0.55s ease-in-out;
  }
  #agr-intro.on { display: flex; }
  #agr-intro.out { opacity: 0; pointer-events: none; }

  .intro-glow {
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.9s ease-out;
    background:
      radial-gradient(560px 420px at 50% 42%, rgba(59, 82, 180, 0.28), transparent 70%),
      radial-gradient(700px 520px at 52% 60%, rgba(122, 91, 255, 0.14), transparent 72%);
  }
  #agr-intro.lit .intro-glow { opacity: 1; }

  .intro-cmd {
    font-family: var(--font-mono);
    font-size: 26px;
    letter-spacing: 0.02em;
    color: rgba(255, 255, 255, 0.9);
    user-select: none;
    transition: opacity 0.28s ease-in, transform 0.28s ease-in, filter 0.28s ease-in;
  }
  @media (min-width: 640px) { .intro-cmd { font-size: 30px; } }
  .intro-cmd.submit {
    opacity: 0;
    transform: translateY(-26px);
    filter: blur(6px);
  }
  .intro-cmd.gone { display: none; }

  .intro-prompt { color: #5b8dff; margin-right: 12px; }

  .intro-underscore {
    display: inline-block;
    width: 0.62em;
    border-bottom: 3px solid rgba(255, 255, 255, 0.9);
    margin-left: 2px;
  }

  .intro-logo-wrap {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .intro-icon {
    width: 120px;
    height: 120px;
    border-radius: 28px;
    box-shadow: 0 18px 60px rgba(59, 82, 180, 0.45);
    animation: agr-spring-in 0.62s cubic-bezier(0.34, 1.4, 0.5, 1) both;
  }

  .intro-loader {
    position: absolute;
    bottom: 13%;
    left: 50%;
    transform: translateX(-50%);
    width: 240px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
    animation: intro-rise 0.4s ease-out 0.15s both;
  }
  @keyframes intro-rise {
    from { opacity: 0; transform: translateX(-50%) translateY(10px); }
    to   { opacity: 1; transform: translateX(-50%) translateY(0); }
  }

  .intro-bar {
    position: relative;
    width: 100%;
    height: 3px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.15);
    overflow: hidden;
  }
  .intro-bar-fill {
    position: absolute;
    inset: 0 auto 0 0;
    width: 0%;
    border-radius: 999px;
    background: linear-gradient(90deg, #38b6ff, #5b8dff, #7a5bff);
    box-shadow: 0 0 14px rgba(122, 91, 255, 0.75);
    transition: width 90ms linear;
  }
  .intro-bar-sheen {
    position: absolute;
    inset: 0 auto 0 0;
    width: 64px;
    background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.4), transparent);
    opacity: 0;
  }

  .intro-wordmark {
    color: rgba(255, 255, 255, 0.75);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
  }
</style>

<script>
  // Phase timings (ms), matching src/components/Splash.tsx in the app.
  const PROMPT_MS = 800;
  const TYPE_MS = 70;
  const HOLD_MS = 420;
  const SUBMIT_MS = 300;
  const LOGO_MS = 2100;
  const NAME = 'Agentrium';

  const root = document.getElementById('agr-intro');
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const seen = sessionStorage.getItem('agr-intro-seen');

  if (root && !seen && !reduced) {
    sessionStorage.setItem('agr-intro-seen', '1');
    root.classList.add('on');
    document.documentElement.style.overflow = 'hidden';

    const cmd = document.getElementById('intro-cmd');
    const typed = document.getElementById('intro-typed');
    const logo = document.getElementById('intro-logo');
    const loader = document.getElementById('intro-loader');
    const fill = document.getElementById('intro-bar-fill');
    const sheen = document.getElementById('intro-bar-sheen');

    const timers: number[] = [];
    let raf = 0;
    let done = false;

    const finish = () => {
      if (done) return;
      done = true;
      timers.forEach(clearTimeout);
      cancelAnimationFrame(raf);
      root.classList.add('out');
      window.setTimeout(() => {
        root.remove();
        document.documentElement.style.overflow = '';
      }, 600);
      window.removeEventListener('keydown', onKey);
      window.removeEventListener('wheel', finish);
      window.removeEventListener('touchmove', finish);
    };

    const onKey = () => finish();
    root.addEventListener('click', finish);
    window.addEventListener('keydown', onKey);
    window.addEventListener('wheel', finish, { passive: true });
    window.addEventListener('touchmove', finish, { passive: true });

    const at = (ms: number, fn: () => void) => timers.push(window.setTimeout(fn, ms));

    for (let i = 1; i <= NAME.length; i++) {
      at(PROMPT_MS + i * TYPE_MS, () => { if (typed) typed.textContent = NAME.slice(0, i); });
    }
    const typedDone = PROMPT_MS + NAME.length * TYPE_MS;

    at(typedDone + HOLD_MS, () => cmd?.classList.add('submit'));
    at(typedDone + HOLD_MS + SUBMIT_MS, () => {
      cmd?.classList.add('gone');
      root.classList.add('lit');
      if (logo) logo.hidden = false;
      if (loader) loader.hidden = false;

      const start = performance.now();
      const tick = (t: number) => {
        const p = Math.min(1, (t - start) / LOGO_MS);
        if (fill) fill.style.width = `${p * 100}%`;
        if (sheen) {
          sheen.style.left = `calc(${p * 100}% - 4rem)`;
          sheen.style.opacity = p > 0.02 && p < 0.99 ? '1' : '0';
        }
        if (p < 1) raf = requestAnimationFrame(tick);
      };
      raf = requestAnimationFrame(tick);
    });
    at(typedDone + HOLD_MS + SUBMIT_MS + LOGO_MS + 150, finish);
  } else if (root) {
    root.remove();
  }
</script>
