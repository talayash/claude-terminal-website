---
import '../styles/global.css';
import Analytics from '@vercel/analytics/astro';
import SpeedInsights from '@vercel/speed-insights/astro';

interface Props {
  title?: string;
  description?: string;
}
const {
  title = 'Agentrium - every agent, one window',
  description = 'Run Claude Code, Codex, Cursor, and Antigravity side by side. The native desktop home for developers who spawn many agent sessions at once.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#080A12" />

    <link rel="icon" type="image/png" href="/icons/icon.png" />
    <link rel="apple-touch-icon" href="/icons/icon.png" />

    <link rel="preconnect" href="https://rsms.me/" crossorigin />
    <link rel="preload" as="style" href="https://rsms.me/inter/inter.css" />
    <link rel="stylesheet" href="https://rsms.me/inter/inter.css" />

    <title>{title}</title>

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content="/screenshots/main-view.png" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="/screenshots/main-view.png" />

    <slot name="head" />
  </head>
  <body>
    <slot />
    <Analytics />
    <SpeedInsights />

    <script>
      // Scroll reveal: .reveal elements slide in when they enter the
      // viewport. With reduced motion the CSS already shows everything.
      const els = document.querySelectorAll('.reveal');
      if ('IntersectionObserver' in window && els.length) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                e.target.classList.add('in');
                io.unobserve(e.target);
              }
            }
          },
          { threshold: 0.15, rootMargin: '0px 0px -40px 0px' }
        );
        els.forEach((el) => io.observe(el));
      } else {
        els.forEach((el) => el.classList.add('in'));
      }
    </script>
  </body>
</html>
