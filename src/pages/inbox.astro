---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Inbox - Agentrium" description="Feedback inbox - private.">
  <Fragment slot="head">
    <meta name="robots" content="noindex, nofollow, noarchive" />
  </Fragment>

  <main class="min-h-screen pt-10 pb-16">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-wrap items-end justify-between gap-4 mb-8">
        <div>
          <div class="flex items-center gap-3 mb-2">
            <span class="inline-flex items-center gap-2 px-2.5 py-1 rounded-full bg-[var(--coral)]/15 border border-[var(--coral)]/30 text-[var(--coral)] text-xs">
              INBOX
            </span>
            <span class="text-xs text-[var(--muted-label)]">/inbox</span>
          </div>
          <h1 class="text-3xl sm:text-4xl font-bold text-[var(--ink)]">Feedback</h1>
          <p class="text-[var(--muted-body)] text-sm mt-1">Messages sent from the Contact form inside Agentrium.</p>
        </div>

        <div class="flex items-center gap-2">
          <label class="text-xs text-[var(--muted-body)] flex items-center gap-1.5 select-none">
            <input id="filter-unread" type="checkbox" class="accent-[var(--coral)]" />
            unread only
          </label>
          <button
            id="refresh-btn"
            type="button"
            class="text-xs px-3 py-1.5 rounded-md bg-[var(--coral)]/20 hover:bg-[var(--coral)]/30 border border-[var(--coral)]/40 text-[var(--coral)] transition-colors"
          >
            refresh
          </button>
        </div>
      </div>

      <div class="grid grid-cols-3 gap-4 mb-6">
        <div class="surface rounded-xl p-5">
          <div class="text-xs uppercase tracking-wider text-[var(--muted-label)] mb-2">Total</div>
          <div id="kpi-total" class="text-3xl font-bold text-[var(--ink)] tabular-nums">-</div>
        </div>
        <div class="surface rounded-xl p-5">
          <div class="text-xs uppercase tracking-wider text-[var(--muted-label)] mb-2">Unread</div>
          <div id="kpi-unread" class="text-3xl font-bold text-[var(--coral)] tabular-nums">-</div>
        </div>
        <div class="surface rounded-xl p-5">
          <div class="text-xs uppercase tracking-wider text-[var(--muted-label)] mb-2">Last Refreshed</div>
          <div id="last-updated" class="text-sm text-[var(--muted-body)]">-</div>
        </div>
      </div>

      <div id="status-pill" class="text-xs px-3 py-1.5 rounded-md surface text-[var(--muted-label)] mb-4 inline-block">
        loading…
      </div>

      <ul id="messages" class="space-y-3"></ul>

      <div id="empty" class="hidden surface rounded-xl p-8 text-center text-[var(--muted-body)]">
        No messages yet. Send one from Agentrium's Contact button to see it here.
      </div>
    </div>
  </main>

  <script>
    // Same-origin Vercel Edge proxies that hold CT_STATS_TOKEN server-side
    // and gate access via HTTP Basic Auth (INBOX_PASSWORD env var).
    const ENDPOINTS = {
      list: '/api/feedback-list',
      markRead: '/api/feedback-mark-read',
    };
    const $ = (id) => document.getElementById(id);
    const messagesEl = $('messages');
    const emptyState = $('empty');
    const statusPill = $('status-pill');
    const kpiTotal = $('kpi-total');
    const kpiUnread = $('kpi-unread');
    const lastUpdated = $('last-updated');
    const refreshBtn = $('refresh-btn');
    const unreadOnly = $('filter-unread');

    const timeAgo = (iso) => {
      const d = new Date(iso);
      const secs = Math.max(0, Math.floor((Date.now() - d.getTime()) / 1000));
      if (secs < 60) return `${secs}s ago`;
      if (secs < 3600) return `${Math.floor(secs / 60)}m ago`;
      if (secs < 86400) return `${Math.floor(secs / 3600)}h ago`;
      return `${Math.floor(secs / 86400)}d ago`;
    };

    // DOM builders. Everything user-controlled goes through textContent so
    // a message containing HTML/script tags renders as literal text, not as
    // executable markup.
    const el = (tag, className) => {
      const n = document.createElement(tag);
      if (className) n.className = className;
      return n;
    };
    const text = (tag, className, str) => {
      const n = el(tag, className);
      n.textContent = str;
      return n;
    };

    async function markRead(ids) {
      await fetch(ENDPOINTS.markRead, {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ ids }),
        credentials: 'include',
      });
    }

    function buildCard(item) {
      const unread = item.read_at === null;
      const li = el('li', `surface rounded-xl p-5 ${unread ? 'border-l-4 border-[var(--coral)]' : ''}`);

      const header = el('div', 'flex items-start justify-between gap-4 mb-2');
      const headerLeft = el('div', '');

      const nameRow = el('div', 'flex items-center gap-2 mb-1');
      nameRow.appendChild(text('span', 'font-semibold text-[var(--ink)]', item.name));
      if (unread) {
        nameRow.appendChild(
          text(
            'span',
            'text-[10px] uppercase tracking-wider px-1.5 py-0.5 rounded bg-[var(--coral)]/20 text-[var(--coral)]',
            'new',
          ),
        );
      }
      headerLeft.appendChild(nameRow);

      const meta = el('div', 'text-xs text-[var(--muted-label)] flex flex-wrap gap-x-3 gap-y-1');
      meta.appendChild(text('span', '', timeAgo(item.ts)));
      meta.appendChild(text('span', '', `v${item.app_version}`));
      meta.appendChild(text('span', '', item.os));
      meta.appendChild(text('span', '', item.country));
      headerLeft.appendChild(meta);

      header.appendChild(headerLeft);

      if (unread) {
        const btn = text(
          'button',
          'text-xs px-2 py-1 rounded bg-[var(--coral)]/10 hover:bg-[var(--coral)]/20 text-[var(--coral)] border border-[var(--coral)]/30',
          'mark read',
        );
        btn.addEventListener('click', async () => {
          await markRead([item.id]);
          await load();
        });
        header.appendChild(btn);
      }
      li.appendChild(header);

      li.appendChild(
        text('p', 'text-[var(--ink)] text-sm whitespace-pre-wrap leading-relaxed', item.message),
      );
      return li;
    }

    function render(items) {
      // Empty then re-append; simpler than diffing for the volume we expect.
      while (messagesEl.firstChild) messagesEl.removeChild(messagesEl.firstChild);
      if (items.length === 0) {
        emptyState.classList.remove('hidden');
        return;
      }
      emptyState.classList.add('hidden');
      for (const item of items) messagesEl.appendChild(buildCard(item));
    }

    async function load() {
      statusPill.textContent = 'loading…';
      const url = new URL(ENDPOINTS.list, window.location.origin);
      if (unreadOnly.checked) url.searchParams.set('unread_only', '1');
      url.searchParams.set('limit', '200');
      try {
        const res = await fetch(url, { cache: 'no-store', credentials: 'include' });
        if (!res.ok) {
          statusPill.textContent = `error: ${res.status}`;
          return;
        }
        const data = await res.json();
        kpiTotal.textContent = String(data.total ?? '-');
        kpiUnread.textContent = String(data.unread ?? '-');
        lastUpdated.textContent = new Date().toLocaleTimeString();
        render(data.items ?? []);
        statusPill.textContent = `${data.items?.length ?? 0} shown`;
      } catch (err) {
        statusPill.textContent = `error: ${err}`;
      }
    }

    refreshBtn.addEventListener('click', load);
    unreadOnly.addEventListener('change', load);
    load();
  </script>
</Layout>
