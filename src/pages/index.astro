---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import Features from '../components/Features.astro';
import Screenshots from '../components/Screenshots.astro';
import Download from '../components/Download.astro';
import Footer from '../components/Footer.astro';

// Fetch the latest version from GitHub Releases at build time.
let version = '1.29.0'; // fallback; kept close to the current published release
try {
  const res = await fetch('https://api.github.com/repos/talayash/claude-terminal/releases/latest', {
    headers: { Accept: 'application/vnd.github.v3+json' },
  });
  if (res.ok) {
    const data = await res.json();
    version = data.tag_name?.replace(/^v/, '') || version;
  } else {
    console.warn(`GitHub releases API returned ${res.status}, using fallback version ${version}`);
  }
} catch (e) {
  console.warn(`Failed to fetch GitHub release: ${e}, using fallback version ${version}`);
}
---

<Layout title="Claude Terminal - run Claude Code in parallel">
  <Navbar version={version} />
  <Hero version={version} />
  <Features />
  <Screenshots />
  <Download version={version} />
  <Footer version={version} />
</Layout>
