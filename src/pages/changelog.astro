---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import changelogJson from '../data/changelog.json';

type Feature = { title: string; description: string };
type Release = { version: string; date: string; features: Feature[] };
const releases = changelogJson as Release[];

// Format ISO date like "2026-07-23" into "23 Jul 2026" for display.
function formatDate(iso: string): string {
  try {
    const d = new Date(iso);
    if (Number.isNaN(d.getTime())) return iso;
    return d.toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' });
  } catch {
    return iso;
  }
}
---

<Layout title="Changelog - Agentrium" description="Release history for Agentrium.">
  <Navbar />
  <main class="changelog">
    <div class="container-text">
      <p class="kicker changelog-kicker">Changelog</p>
      <h1 class="h2 changelog-h1">Release history.</h1>

      <ol class="release-list">
        {releases.map(r => (
          <li class="release">
            <div class="release-head">
              <span class="release-version coral-num">v{r.version}</span>
              <span class="release-date">{formatDate(r.date)}</span>
            </div>
            <ul class="release-features">
              {(r.features ?? []).map(f => (
                <li class="release-feature">
                  <span class="feature-title-inline">{f.title}.</span>
                  <span class="feature-desc-inline"> {f.description}</span>
                </li>
              ))}
            </ul>
          </li>
        ))}
      </ol>
    </div>
  </main>
  <Footer />
</Layout>

<style>
  .changelog { padding: 150px 0 100px; background: var(--page); }

  .changelog-kicker { margin-bottom: 10px; }
  .changelog-h1 { margin-bottom: 44px; }

  .release-list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--hairline);
  }
  .release {
    padding: 28px 0;
    border-bottom: 1px solid var(--hairline);
  }
  .release-head {
    display: flex;
    align-items: baseline;
    gap: 12px;
    margin-bottom: 14px;
  }
  .release-version {
    font-size: 15px;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }
  .release-date {
    font-size: 12px;
    color: var(--muted-label);
  }
  .release-features {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 9px;
  }
  .release-feature {
    font-size: 14px;
    line-height: 1.6;
  }
  .feature-title-inline { font-weight: 600; color: var(--ink); }
  .feature-desc-inline { color: var(--muted-body); }
</style>
